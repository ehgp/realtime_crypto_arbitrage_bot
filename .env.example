# Auth0 (frontend)
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_SECRET=
APP_BASE_URL=http://localhost:3000
AUTH0_AUDIENCE=https://backend.cloudaitrader.com

# Auth0 (backend verify + management)
AUTH0_M2M_CLIENT_ID=
AUTH0_M2M_CLIENT_SECRET=

# DB (dev values point at compose postgres; roles per PLAN.md D14)
DATABASE_URL=postgres://app_user:app_user@localhost:5432/cloudaitrader
SERVICE_DATABASE_URL=postgres://service_role:service_role@localhost:5432/cloudaitrader
DIRECT_URL=postgres://postgres:postgres@localhost:5432/cloudaitrader
WORKER_DATABASE_URL=postgres://worker_role:worker_role@localhost:5432/cloudaitrader

# Edge / services (empty until Phase 6+)
TURNSTILE_SECRET=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
RESEND_API_KEY=
ADMIN_NOTIFICATION_EMAIL=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
SENTRY_DSN_FRONTEND=
SENTRY_DSN_BACKEND=
SENTRY_DSN_WORKER=

# App (admin bootstrap is a CLI, not env; PLAN.md D12)
# Host port the dev compose publishes the backend on (container stays 4000).
# 4200 avoids sibling stacks on this machine (gtm-engineering:4000, myaicv:4100).
MAIN_PORT=4200
API_BASE_URL=http://localhost:4200
MFA_MAX_ATTEMPTS=5
MFA_LOCKOUT_MS=900000
MFA_ENC_KEYS={"1":"<32-byte-hex>"}
MFA_ENC_KEY_ACTIVE=1
