# === Auth0 (tenant cloudaitrader.us.auth0.com; wired in Phase 2 -- leave secrets empty until then) ===
# Issuer and JWKS URI are DERIVED from AUTH0_DOMAIN in the env loaders (invariant 17):
#   issuer = https://$AUTH0_DOMAIN/   jwks = https://$AUTH0_DOMAIN/.well-known/jwks.json
AUTH0_DOMAIN=cloudaitrader.us.auth0.com
AUTH0_AUDIENCE=https://cloudaitrader.com
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_SECRET=
APP_BASE_URL=http://localhost:3000

# Auth0 Management API (M2M app) -- enables Auth0-native email/name updates + verification email.
# Create a Machine-to-Machine app authorized for the Auth0 Management API
# (audience https://cloudaitrader.us.auth0.com/api/v2/) with scopes: read:users update:users.
# Until these are set, PATCH /auth/profile email changes return 503 (display name still works).
AUTH0_M2M_CLIENT_ID=
AUTH0_M2M_CLIENT_SECRET=
# DB connection name for email-change verification (matches the user's identity connection).
AUTH0_DB_CONNECTION=Username-Password-Authentication

# DB (four canonical DSNs; roles app_user / app_service / worker_user / owner -- PLAN.md D14)
DATABASE_URL=
SERVICE_DATABASE_URL=
DIRECT_URL=
WORKER_DATABASE_URL=

# Edge / services (empty until Phase 6+)
TURNSTILE_SECRET=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
SENTRY_DSN_FRONTEND=
SENTRY_DSN_BACKEND=
SENTRY_DSN_WORKER=

# Email (Resend)
# Leave RESEND_API_KEY empty to use dev mode (logs emails to console instead of sending)
RESEND_API_KEY=
RESEND_FROM_EMAIL=No Reply for Cloud AI Trader application <noreply@egventures.net>
ADMIN_NOTIFICATION_EMAIL=info@egventures.net
ENABLE_EMAIL_NOTIFICATIONS=true

# === Blob storage (Cloudflare R2 in prod, infra S04/S13) ===
# RESERVED (PLAN.md invariant 17 / H-R2-1): no code may read these until a storage decision adds a sprint.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_DOMAIN=

# App (admin bootstrap is a CLI, not env; PLAN.md D12)
# Host port the dev compose publishes the backend on (container stays 4000).
# 4200 avoids sibling stacks on this machine (gtm-engineering:4000, myaicv:4100).
MAIN_PORT=4200
API_BASE_URL=http://localhost:4200
MFA_MAX_ATTEMPTS=5
MFA_LOCKOUT_MS=900000
MFA_ENC_KEYS={"1":"<32-byte-hex>"}
MFA_ENC_KEY_ACTIVE=1
