# Auth0 (frontend)
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_SECRET=
APP_BASE_URL=http://localhost:3000
AUTH0_AUDIENCE=https://backend.cloudaitrader.com

# Auth0 (backend verify + management)
AUTH0_M2M_CLIENT_ID=
AUTH0_M2M_CLIENT_SECRET=

# DB (dev values point at compose postgres; roles per PLAN.md D14)
DATABASE_URL=
SERVICE_DATABASE_URL=
DIRECT_URL=
WORKER_DATABASE_URL=

# Edge / services (empty until Phase 6+)
TURNSTILE_SECRET=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
SENTRY_DSN_FRONTEND=
SENTRY_DSN_BACKEND=
SENTRY_DSN_WORKER=

# Email (Resend)
# Leave RESEND_API_KEY empty to use dev mode (logs emails to console instead of sending)
RESEND_API_KEY=
RESEND_FROM_EMAIL=No Reply for Cloud AI Trader application <noreply@egventures.net>
ADMIN_NOTIFICATION_EMAIL=info@egventures.net
ENABLE_EMAIL_NOTIFICATIONS=true

# === Blob storage (Cloudflare R2 in prod, infra S04/S13) ===
# RESERVED (PLAN.md invariant 17 / H-R2-1): no code may read these until a storage decision adds a sprint.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_DOMAIN=

# App (admin bootstrap is a CLI, not env; PLAN.md D12)
# Host port the dev compose publishes the backend on (container stays 4000).
# 4200 avoids sibling stacks on this machine (gtm-engineering:4000, myaicv:4100).
MAIN_PORT=4200
API_BASE_URL=http://localhost:4200
MFA_MAX_ATTEMPTS=5
MFA_LOCKOUT_MS=900000
MFA_ENC_KEYS={"1":"<32-byte-hex>"}
MFA_ENC_KEY_ACTIVE=1
